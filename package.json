{
  "name": "@playding/redis-cacher",
  "version": "0.5.2",
  "description": "A simple interface cacher based on ioredis",
  "main": "./lib/cache.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "doc": "documentation readme lib/cache.js --section=JSDoc",
    "coverage": "nyc report --reporter=text-lcov | coveralls",
    "test": "nyc ava -v",
    "release": "standard-version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yidinghan/interface-cacher.git"
  },
  "keywords": [
    "cacher",
    "redis",
    "ioredis"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yidinghan/interface-cacher/issues"
  },
  "homepage": "https://github.com/yidinghan/interface-cacher#readme",
  "dependencies": {
    "ioredis": "^5.2.3",
    "lodash.defaultsdeep": "^4.6.0",
    "lodash.isundefined": "^3.0.1",
    "lru-cache": "^7.14.0"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "ava": "^4.3.3",
    "coveralls": "^3.1.1",
    "documentation": "^14.0.0",
    "eslint": "^8.23.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.26.0",
    "lodash": "^4.17.11",
    "nyc": "^15.1.0",
    "standard-version": "^9.5.0"
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "serial": true,
    "failFast": false
  }
