  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "ava": "^4.3.3",
    "coveralls": "^3.1.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
